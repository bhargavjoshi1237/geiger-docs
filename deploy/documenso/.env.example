# Documenso for Geiger Docs. Copy to .env next to compose.yml and fill in. Never commit .env.
# Secrets: `openssl rand -base64 32`; DB password: `openssl rand -hex 24` (URL-safe).

# --- Compose / host ---
# Host address the container port binds to (keep 127.0.0.1 behind a reverse proxy)
DOCUMENSO_BIND_ADDRESS=127.0.0.1
# Port Documenso listens on inside the container and on the host
PORT=3000
# Host path of the signing certificate mounted at /opt/documenso/cert.p12 (owned by uid 1001, chmod 400)
DOCUMENSO_CERT_FILE=/opt/documenso/cert.p12

# --- Postgres (the compose "database" service) ---
# Database user created on first boot
POSTGRES_USER=documenso
# Database password (hex so it is safe inside the URL below)
POSTGRES_PASSWORD=
# Database name created on first boot
POSTGRES_DB=documenso

# --- Licence ---
# Leave empty: we run the Community Edition (AGPL, unmodified); a key only unlocks Enterprise features
NEXT_PRIVATE_DOCUMENSO_LICENSE_KEY=

# --- URLs ---
# Public HTTPS origin of Documenso; Geiger Docs' DOCUMENSO_URL must equal this
NEXT_PUBLIC_WEBAPP_URL=https://sign.geiger.studio
# URL the app uses to call itself for background jobs (emails, webhooks); keep it container-local
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000
# Comma-separated hosts/IPs allowed as webhook targets on private networks; empty when the app has a public URL
NEXT_PRIVATE_WEBHOOK_SSRF_BYPASS_HOSTS=

# --- Secrets ---
# Session encryption secret
NEXTAUTH_SECRET=
# Primary symmetric encryption key, at least 32 characters; never change after first boot
NEXT_PRIVATE_ENCRYPTION_KEY=
# Secondary symmetric encryption key, at least 32 characters; never change after first boot
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# --- Database connection ---
# Postgres URL; must match POSTGRES_* above, host is the compose service "database"
NEXT_PRIVATE_DATABASE_URL=postgresql://documenso:CHANGE_ME@database:5432/documenso
# Direct (non-pooled) URL for migrations; defaults to NEXT_PRIVATE_DATABASE_URL when empty
NEXT_PRIVATE_DIRECT_DATABASE_URL=

# --- Signing certificate ---
# Signing backend: local (.p12 file); gcloud-hsm and csc are alternatives (csc is Enterprise-only)
NEXT_PRIVATE_SIGNING_TRANSPORT=local
# Passphrase of cert.p12; must NOT be empty or signing fails with "Failed to get private key bags"
NEXT_PRIVATE_SIGNING_PASSPHRASE=
# Optional RFC 3161 timestamp authority URL(s), comma-separated; enables long-term validation
NEXT_PRIVATE_SIGNING_TIMESTAMP_AUTHORITY=
# Optional reason embedded in PDF signatures (default "Signed by Documenso")
NEXT_PRIVATE_SIGNING_REASON=
# Optional contact info embedded in PDF signatures (default: the web app URL)
NEXT_PUBLIC_SIGNING_CONTACT_INFO=
# Container cert path; set in compose.yml from the mount, listed here for reference only
# NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/documenso/cert.p12
# Alternative to the mount (base64 .p12, wins over the path); not wired in compose.yml, we use the file mount
# NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS=

# --- Email (Resend, suite account) ---
# Email transport; resend uses the Resend API (no SMTP host needed)
NEXT_PRIVATE_SMTP_TRANSPORT=resend
# Resend API key with sending access to the verified geiger.studio domain (prefer a dedicated key)
NEXT_PRIVATE_RESEND_API_KEY=
# Sender display name on all signing emails
NEXT_PRIVATE_SMTP_FROM_NAME="Geiger Docs"
# Sender address; must be on the Resend-verified geiger.studio domain
NEXT_PRIVATE_SMTP_FROM_ADDRESS=signing@geiger.studio
# SMTP settings below are only for the smtp-auth/smtp-api transports; unused with resend
# NEXT_PRIVATE_SMTP_HOST=
# NEXT_PRIVATE_SMTP_PORT=
# NEXT_PRIVATE_SMTP_USERNAME=
# NEXT_PRIVATE_SMTP_PASSWORD=
# NEXT_PRIVATE_SMTP_SECURE=

# --- Document storage ---
# Where uploaded/signed PDFs live: database (default, fine at our volume) or s3
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
# S3-compatible endpoint (only for s3, e.g. R2/MinIO)
NEXT_PRIVATE_UPLOAD_ENDPOINT=
# Use path-style S3 URLs (only for s3; often true for MinIO)
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE=false
# S3 region (only for s3)
NEXT_PRIVATE_UPLOAD_REGION=
# S3 bucket (required for s3)
NEXT_PRIVATE_UPLOAD_BUCKET=
# S3 access key id (only for s3)
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=
# S3 secret access key (only for s3)
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=
# Max upload size in MB (Documenso default 50)
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=50
# Gotenberg URL for DOCX-to-PDF; leave empty, Geiger Docs only uploads PDFs
NEXT_PRIVATE_DOCUMENT_CONVERSION_URL=

# --- Background jobs ---
# Job runner for emails/webhooks: local (Postgres, default) | bullmq (needs Redis) | inngest
NEXT_PRIVATE_JOBS_PROVIDER=local
# Redis URL, only for bullmq (e.g. redis://redis:6379)
NEXT_PRIVATE_REDIS_URL=

# --- Access and features ---
# Block all self-signup; operators are created by an admin (first boot overrides this once, see README)
NEXT_PUBLIC_DISABLE_SIGNUP=true
# Keep empty/false: billing off means no plan gates or document quotas on self-hosted
NEXT_PUBLIC_FEATURE_BILLING_ENABLED=
# PostHog analytics key; leave empty to disable
NEXT_PUBLIC_POSTHOG_KEY=
# Disable Documenso's anonymous self-host telemetry (version + installation id)
DOCUMENSO_DISABLE_TELEMETRY=true
