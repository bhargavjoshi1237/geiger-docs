# Runtime (browser): the suite-shared Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same cookie domain the hub uses, e.g. .geiger.studio (blank locally)
NEXT_PUBLIC_COOKIE_DOMAIN=

# Hub origin that serves /login, e.g. https://geiger.studio (http://localhost:3000 locally; blank = /login on this origin)
NEXT_PUBLIC_DASH_ORIGIN=

# Server-only: service role for webhook writes, notifications and storage
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: direct Postgres connection for migrations (@geiger/orm), never NEXT_PUBLIC_
STRING_URI=

# Server-only: Documenso origin, e.g. https://sign.geiger.studio (no trailing /api/v2)
DOCUMENSO_URL=

# Server-only: Documenso team API token
DOCUMENSO_API_TOKEN=

# Server-only: shared secret Documenso sends in X-Documenso-Secret
DOCUMENSO_WEBHOOK_SECRET=
